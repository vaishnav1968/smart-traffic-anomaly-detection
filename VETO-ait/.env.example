# VETO - Zero-Trust Runtime Security Environment Configuration

# LLM Provider Configuration (Optional - deterministic test agent active if not set)
GROK_API_KEY=
MODEL_NAME=grok-beta
API_BASE_URL=https://api.x.ai/v1

# VETO Core Configuration
VETO_ENV=development
VETO_HOST=0.0.0.0
VETO_PORT=8000
VETO_SECRET_KEY=veto_super_secret_local_key_change_in_production
DATABASE_PATH=veto_audit.db

# Policies & Configurations
POLICIES_FILE=configs/policies.yaml
MCP_TOOLS_FILE=configs/mcp_tools.json
WORKSPACE_DIR=agent/workspace

# Arduino Hardware Configuration
ARDUINO_PORT=COM3
ARDUINO_BAUD=115200
ARDUINO_SIMULATION_MODE=false # Set to true to run headless without physical Arduino

# Security & Heartbeat
APPROVAL_TIMEOUT_SECONDS=60
HEARTBEAT_TIMEOUT_SECONDS=5
FAIL_CLOSED=true
